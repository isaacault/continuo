# Copy to .env next to compose.yaml. Secrets live here only.
PUID=1000
PGID=1000
TZ=Europe/London

# Which parts continuo runs: the same as the compose profiles you start (music, video, or both).
CONTINUO_MODULES=music,video
# Where apps reach continuo, as they'll see it (behind your proxy): sign-in answers carry it.
PUBLIC_BASE_URL=https://continuo.example.com
JWT_SECRET=                       # openssl rand -hex 32
ADMIN_USER=admin                  # first boot only: this admin account is created with ADMIN_PASSWORD
ADMIN_PASSWORD=
# CORS_ALLOW_ORIGINS=https://polyorama.example.com   # the Polyorama web app's address, if on another host

# --- music ------------------------------------------------------------------------------------
LIDARR_API_KEY=                   # Lidarr: Settings, General
LIDARR_WEBHOOK_SECRET=            # openssl rand -hex 24; Lidarr's webhook sends it (docs/install.md)
SLSKD_API_KEY=                    # slskd's API key, from its settings
NAVIDROME_AUTH=password           # continuo signs in to Navidrome as this user:
NAVIDROME_SERVICE_USER=continuo-svc
NAVIDROME_SERVICE_PASSWORD=       # create the user in Navidrome first (an admin)

# --- video ------------------------------------------------------------------------------------
JELLYFIN_API_KEY=                 # Jellyfin: Dashboard, API Keys
VIDEO_PUBLIC_BASE_URL=            # where apps reach Jellyfin, e.g. https://watch.example.com
TMDB_API_KEY=                     # themoviedb.org: Settings, API (the v3 key or the read access token)
TMDB_LANGUAGE=en-GB
TMDB_REGION=GB
RADARR_API_KEY=                   # Radarr: Settings, General
RADARR_QUALITY_PROFILE_ID=1       # Radarr: Settings, Profiles (1 is "Any")
SONARR_API_KEY=                   # Sonarr: Settings, General
SONARR_QUALITY_PROFILE_ID=1
