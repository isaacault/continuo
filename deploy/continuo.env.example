# secrets/continuo.env (sops-encrypted in the homelab repo). Everything non-secret lives in the
# compose file's environment block.
JWT_SECRET=                     # openssl rand -hex 32
ADMIN_PASSWORD=                 # first boot only: seeds ADMIN_USER as admin
LIDARR_API_KEY=
LIDARR_WEBHOOK_SECRET=          # openssl rand -hex 24; also set as the Lidarr webhook's X-Webhook-Secret header
SLSKD_API_KEY=
HA_WEBHOOK_URL=                 # http://192.168.0.101:8123/api/webhook/<id from the HA automation>
UPTIME_KUMA_PUSH_URL=           # http://uptime-kuma:3001/api/push/<token>
NAVIDROME_SERVICE_PASSWORD=     # Phase 1 only (continuo-svc); remove when NAVIDROME_AUTH=header
