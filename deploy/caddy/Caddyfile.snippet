# ── music-api.ault.me: continuo (private: LAN + tailnet only) ─────────────────────────────────
# Everything to continuo, except /rest/* (the façade, to Navidrome; continuo itself answers
# getOpenSubsonicExtensions) and the façade's auth check, which only Caddy itself may call (it
# would otherwise be a credential-checking oracle). continuo has no published port; Caddy reaches it on the compose network, Navidrome on music-auth.
music-api.ault.me {
	import private

	@facade_auth path /internal/auth/*
	handle @facade_auth {
		respond 404
	}

	# OpenSubsonic discovery, answered by continuo: Navidrome's extension list minus formPost (and
	# apiKeyAuthentication), because forward_auth never sees a request body, so clients must keep
	# their credentials in the query string (issue #4). No forward_auth: the spec requires this one
	# endpoint to be public, and continuo neither checks nor forwards credentials here. One
	# directive, so no `route`; if you ever add a second (e.g. request_header), wrap them in
	# `route { }` like the façade below. Caddy tries `handle` blocks with longer paths first, but
	# keep it above /rest/* so the file reads in the order Caddy applies it.
	handle /rest/getOpenSubsonicExtensions* {
		reverse_proxy continuo:8080
	}

	# The Subsonic façade. Any client-sent Remote-User is dropped first; forward_auth then sets it from
	# continuo's answer. Audio flows Navidrome → Caddy → device; continuo only sees the auth subrequest.
	# `route` keeps this order: Caddy's default directive order runs request_header AFTER forward_auth,
	# which would strip the Remote-User forward_auth just set (found on the first deploy).
	handle /rest/* {
		route {
			request_header -Remote-User
			forward_auth continuo:8080 {
				uri /internal/auth/subsonic
				copy_headers Remote-User
			}
			reverse_proxy navidrome-trusted:4533
		}
	}

	handle {
		reverse_proxy continuo:8080
	}
	# No access log here (none of the sites keep one). If you add one, redact the query keys
	# t, s, p, token and the Authorization header — they are credentials.
}

# Phase 2 — on BOTH existing music.ault.me blocks (public :8443 and private), add as the first
# line inside the block: Navidrome must never see a client-supplied Remote-User. (They proxy via
# host.docker.internal, which isn't a trusted source anyway; this is the second lock.)
#
# music.ault.me:8443 {
# 	import public
# 	request_header -Remote-User
# 	reverse_proxy host.docker.internal:4533
# }
# music.ault.me {
# 	import private
# 	request_header -Remote-User
# 	reverse_proxy host.docker.internal:4533
# }
